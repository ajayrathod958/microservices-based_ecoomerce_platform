# Copy/edit for your environment. NEVER commit real secrets.
POSTGRES_USER=microshop
POSTGRES_PASSWORD=microshop_pw
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_REPLENISH=20
RATE_LIMIT_BURST=40

# --- Phase 2: security (CHANGE for any non-local use; JWT_SECRET >= 32 chars) ---
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
INTERNAL_TOKEN=dev-only-internal-token-change-me
ADMIN_EMAIL=admin@microshop.local
ADMIN_PASSWORD=Admin@12345
